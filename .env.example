# Copy to .env.local (or .env) in the repo you scan, or the directory you run
# doppel from, and fill in the provider(s) you use. Keys left blank are ignored.
# With several keys set, the preset is chosen in this order: Anthropic, OpenAI,
# Nebius. Variables already set in your shell or CI take precedence over files.
# Never commit the real file.

# Anthropic (Claude). Enables the built-in "anthropic" preset.
ANTHROPIC_API_KEY=

# OpenAI. Enables the built-in "openai" preset.
OPENAI_API_KEY=

# Nebius Token Factory (NVIDIA Nemotron). Enables the built-in "nebius" preset.
NEBIUS_API_KEY=

# OpenRouter, for --model openrouter:<vendor>/<model>.
OPENROUTER_API_KEY=

# Ollama runs locally and needs no key. Override the default URL if needed.
# OLLAMA_BASE_URL=http://localhost:11434/v1
